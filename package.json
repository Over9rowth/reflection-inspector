{
  "name": "reflection-inspector",
  "productName": "反光检查镜",
  "version": "1.0.0",
  "private": true,
  "description": "反光检查镜 — 自动找出照片里的玻璃和镜面反光区域，支持反光减弱预览与细节检查",
  "author": "Over9rowth",
  "license": "GPL-3.0-only",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "dev": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test:node": "node --test tests/rle.test.cjs tests/env.test.cjs tests/paint.test.cjs",
    "test": "npm run test:node && .venv\\Scripts\\python.exe -m unittest discover -s tests -p \"test_*.py\"",
    "test:py": ".venv\\Scripts\\python.exe -m unittest discover -s tests -p \"test_*.py\"",
    "smoke:worker": ".venv\\Scripts\\python.exe scripts/smoke-worker.py tests/fixtures/mirror.jpg --smoke",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "smoke:manual": "npm run build && node scripts/smoke-manual.mjs",
    "manual": "npm run build && electron scripts/make-manual-pdf.mjs",
    "icon": "node scripts/make-icon.mjs",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.10.2",
    "@electron-forge/maker-squirrel": "7.10.2",
    "@electron-forge/maker-zip": "7.10.2",
    "@types/node": "24.10.1",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "electron": "44.9.3",
    "esbuild": "0.25.11",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "asar": false,
        "name": "ReflectionInspector",
        "executableName": "ReflectionInspector",
        "appBundleId": "local.instruments.reflection",
        "appCopyright": "Copyright (C) 2026 Over9rowth (GPL-3.0)",
        "appVersion": "0.2.0",
        "icon": "resources/icon.ico",
        "win32metadata": {
          "CompanyName": "Over9rowth",
          "FileDescription": "反光检查镜",
          "ProductName": "反光检查镜",
          "LegalCopyright": "Copyright (C) 2026 Over9rowth (GPL-3.0)",
          "InternalName": "ReflectionInspector",
          "OriginalFilename": "ReflectionInspector.exe"
        },
        "ignore": [
          "^/tests",
          "^/docs",
          "^/src",
          "^/scripts",
          "^/outputs",
          "^/out",
          "^/out-",
          "^/node_modules",
          "^/worker/__pycache__",
          "^/\\.venv",
          "^/resources/models",
          "^/project_meta",
          "^/SPEC\\.md$"
        ]
      },
      "makers": [
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "win32"
          ]
        },
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "ReflectionInspector",
            "setupIcon": "resources/icon.ico",
            "title": "反光检查镜"
          }
        }
      ]
    }
  },
  "keywords": [
    "electron",
    "typescript",
    "react",
    "desktop-app",
    "windows-app",
    "offline-first",
    "gplv3",
    "image-forensics",
    "normal-map",
    "pbr-materials",
    "fresnel",
    "highlight-removal",
    "roughness-map",
    "computer-vision"
  ]
}
